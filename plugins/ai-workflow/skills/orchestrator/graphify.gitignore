
# Graphify - local state, scratch and cost tracking
graphify-out/.graphify*
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
!graphify-out/.graphify_semantic_marker
graphify-out/.needs_update
graphify-out/cache/
graphify-out/cost.json
graphify-out/transcripts/
graphify-out/memory/
graphify-out/reflections/

# Graphify - dated pre-overwrite backups
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Graphify - large visual export (easy to regenerate locally)
graphify-out/graph.html
