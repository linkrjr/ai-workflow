diff --git a/web/src/saveError.tsx b/web/src/saveError.tsx
new file mode 100644
index 0000000..88c890f
--- /dev/null
+++ b/web/src/saveError.tsx
@@ -0,0 +1,21 @@
+import { createContext, useContext, useState, type ReactNode } from 'react'
+
+// Counts successful saves. A save error stays visible only until the count moves past
+// the value it was first seen at, so any later success (add, toggle or delete) clears it.
+const SavedCount = createContext({ count: 0, bump: () => {} })
+
+export function SaveErrorProvider({ children }: { children: ReactNode }) {
+  const [count, setCount] = useState(0)
+  return <SavedCount value={{ count, bump: () => setCount((c) => c + 1) }}>{children}</SavedCount>
+}
+
+// Call from every mutation's onSuccess.
+export const useReportSaved = () => useContext(SavedCount).bump
+
+export function useSaveError(mutation: { isError: boolean }) {
+  const { count } = useContext(SavedCount)
+  const [seenAt, setSeenAt] = useState<number | null>(null)
+  if (mutation.isError && seenAt === null) setSeenAt(count)
+  if (!mutation.isError && seenAt !== null) setSeenAt(null)
+  return mutation.isError && seenAt === count
+}
